
// Lista de compras
const readline = require("readline/promises");

async function main() {
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  const lista = [];

  while (true) {
    console.log("\n1 - Adicionar | 2 - Remover | 3 - Ver lista | 0 - Sair");
    const opcao = await rl.question("Opção: ");

    if (opcao === "1") {
      const item = await rl.question("Item: ");
      lista.push(item);
      console.log(`'${item}' adicionado.`);
    } else if (opcao === "2") {
      const item = await rl.question("Item para remover: ");
      const indice = lista.indexOf(item);
      if (indice !== -1) {
        lista.splice(indice, 1);
        console.log(`'${item}' removido.`);
      } else {
        console.log("Item não encontrado.");
      }
    } else if (opcao === "3") {
      if (lista.length === 0) {
        console.log("Lista vazia.");
      }
      lista.forEach((item, i) => console.log(`${i + 1}. ${item}`));
    } else if (opcao === "0") {
      console.log("Até mais!");
      break;
    } else {
      console.log("Opção inválida.");
    }
  }

  rl.close();
}

main();

# Lista de compras
lista = []

while True:
    print("\n1 - Adicionar | 2 - Remover | 3 - Ver lista | 0 - Sair")
    opcao = input("Opção: ")

    if opcao == "1":
        item = input("Item: ")
        lista.append(item)
        print(f"'{item}' adicionado.")
    elif opcao == "2":
        item = input("Item para remover: ")
        if item in lista:
            lista.remove(item)
            print(f"'{item}' removido.")
        else:
            print("Item não encontrado.")
    elif opcao == "3":
        if not lista:
            print("Lista vazia.")
        for i, item in enumerate(lista, start=1):
            print(f"{i}. {item}")
    elif opcao == "0":
        print("Até mais!")
        break
    else:
        print("Opção inválida.")

